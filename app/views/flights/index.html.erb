<h1>Search your flight</h1>
<%= simple_form_for :search, url: flights_path, method: :get do |f| %>
  <%= f.input :departure_airport, collection: @airports, label_method: :code, value_method: :id%>
  <%= f.input :arrival_airport, collection: @airports, label_method: :code, value_method: :id %>
  <%= f.input :start_datetime, collection: @flight_dates%>
  <%= f.input :passengers, collection: [1, 2, 3, 4] %>
  <p><%= f.button :submit, "Search" %></p>
<% end %>
<h2>Available Flights</h2>
<ul>
  <%= simple_form_for :book, url: new_booking_path, method: :get do |f| %>
    <% @flights.each do |flight| %>
      <li>
        <p>Departure: <%= flight.departure_airport.code %></p>
        <p>Arrival: <%= flight.arrival_airport.code %></p>
        <p>Date: <%= flight.start_datetime %></p>
        <p>Duration: <%= flight.duration/60%>h</p>
        <p><%= f.radio_button :flight_id, flight.id %>
          <%= f.label :flight_id, "Select this flight", value: flight.id %></p>
      </li>
    <% end %>
    <p><%= f.button :submit, "Book!" %></p>
    <% if params[:search].present?%>
      <%= f.input :passengers, as: :hidden, input_html: { value: params[:search][:passengers] } %>
    <% end %>
  <% end %>
</ul>