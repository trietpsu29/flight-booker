<h1>Complete Your Booking</h1>
<%= simple_form_for @booking do |f| %>
  <p>Departure: <%= @booking.flight.departure_airport.code %></p>
  <p>Arrival: <%= @booking.flight.arrival_airport.code %></p>
  <p>Date: <%= @booking.flight.start_datetime %></p>
  <p>Duration: <%= @booking.flight.duration / 60 %>h</p>
  <div data-controller="passenger" data-passenger-count-value=<%=@booking.passengers.size%>>
    <button type ="button" data-action="passenger#add">Add passenger</button>
    <div data-passenger-target="list">
      <%= f.simple_fields_for :passengers do |p| %>
        <div data-passenger-target="passenger">
          <h3>Passenger <%= p.index + 1 %></h3>
          <p><%= p.input :name %></p>
          <p><%= p.input :email %></p>
          <button type ="button" data-action="passenger#remove">Remove passenger</button>
        </div>
      <% end %>
    </div>
    <template data-passenger-target="template">
      <%= f.simple_fields_for :passengers, Passenger.new,child_index: "NEW" do |p| %>
        <div data-passenger-target="passenger">
          <h3>Passenger NEW</h3>
          <p><%= p.input :name %></p>
          <p><%= p.input :email %></p>
          <button type="button" data-action="passenger#remove">
            Remove passenger
          </button>
        </div>
      <% end %>
    </template>
  </div>
  <%= f.input :flight_id, as: :hidden, value: @booking.flight_id %>
  <p><%= f.button :submit, "Book now!" %></p>
<% end %>